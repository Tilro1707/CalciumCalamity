  matchDurationInSeconds: 210
  slotInfoData:
  - unitName: Warrior
    description: A reliable warrior. Guards the church and strikes down any intruder.
    stats: 'HP 10 | DMG 1 | 2 Souls '
  - unitName: Babarian
    description: A heavy warrior that patrols the area and hits hard with powerful
      swings.
    stats: HP 8 | DMG 2 | 4 souls
  - unitName: Archer
    description: Attacks enemies from a distance, softening them up before they reach
      the church.
    stats: HP 3 | DMG 1 | 7 Souls
  - unitName: Grave
    description: A holy place of darkness. Continually generates souls to expand
      your army
    stats: 0.5 Souls/s | 10 Souls
  - unitName: Fire Milk
    description: Imbues skeletons with fire magic. Enemies burn over time after being
      hit.
    stats: DMG + 2 | DoT | 5 Souls
  - unitName: Lightning Milk
    description: Charges skeletons with static energy. Attacks stun enemies for a
      short duration.
    stats: Stun 0.5s | 5 Souls
  - unitName: Ice Milk
    description: Freezing cold flows through the bones. Drastically slows down enemy
      movement.
    stats: Enemy Spd -60% | 5 Souls
  - unitName: Earth Milk
    description: Ancient magic from the ground. Increases durability but makes skeletons
      heavier.
    stats: HP +50% | Spd -30% | 5 Souls
  winScreenPanel: {fileID: 0}
